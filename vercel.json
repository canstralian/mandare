{
  "version": 2,
  "installCommand": "pip install -r requirements.txt && pip install .",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "RIF_DATA_DIR": "/tmp/rif-data",
    "RIF_ENVIRONMENT": "RIF_Runtime"
  }
}
