# RIF Runtime — environment configuration
#
# Every variable in this file is read by the code. If you add one here, add it
# to the runtime too: tests/test_config_contract.py fails on names that nothing
# in src/ reads, because a documented-but-inert setting is worse than an
# undocumented one — it reads as a control that is doing something.
#
# Settings under [runtime]/[server]/[provider]/[paths] can equivalently be set
# in rif.toml. Environment variables win. Unknown RIF_* keys in rif.toml are
# rejected outright (extra="forbid"), so typos surface immediately.

# --- Runtime -----------------------------------------------------------------

# Starting posture: normal | elevated | restricted | locked
# Applied as a FLOOR on the posture restored from the logs — it can tighten a
# runtime but never relax one. See "Startup posture" in docs/API.md.
RIF_POSTURE=normal

# Named environment profile to activate, from config/environments.yaml.
RIF_ENVIRONMENT=production

# Advisory flag recorded in settings; does not itself open or close egress.
# Egress is decided by the environment profile and the policy rules.
RIF_CLOUD_EGRESS=false

# --- Server ------------------------------------------------------------------

# Default binds all interfaces. Set to 127.0.0.1 unless the service is meant to
# be reachable from off-host.
RIF_SERVER_HOST=0.0.0.0
RIF_SERVER_PORT=8000

# Mount prefix when served behind a reverse proxy at a sub-path.
RIF_SERVER_ROOT_PATH=

# Comma-separated CORS origins. Defaults to http://localhost:3000 when unset.
# Credentials are allowed on these origins, so do not set this to "*".
RIF_CORS_ORIGINS=http://localhost:3000

# --- Paths -------------------------------------------------------------------

# One directory owns every piece of persistent state: policies.json,
# decisions.jsonl, posture_history.jsonl, metasploit_evidence.jsonl.
RIF_DATA_DIR=data
RIF_CONFIG_DIR=config

# --- Provider ----------------------------------------------------------------
#
# Provider settings are configuration, not authorization. Holding a provider
# credential is never a RIF authorization decision.

# local | remote | hybrid
RIF_PROVIDER_MODE=local
RIF_PROVIDER_MODEL=default
RIF_PROVIDER_ENDPOINT=

# --- Authentication ----------------------------------------------------------

# Comma-separated API keys for mutable control-plane operations. Guarded
# operations FAIL CLOSED (503) when this is unset, rather than becoming
# unauthenticated.
RIF_CONTROL_PLANE_API_KEYS=

# Also require the same key on governance-state read endpoints (/v1/audit,
# /v1/policies, /v1/recovered-state, /v1/persistence/summary,
# /v1/telemetry/summary, /v1/graph/summary). Off by default for backward
# compatibility; enable it if the service is reachable beyond a trusted
# network. /health and / stay open either way.
RIF_REQUIRE_READ_AUTH=false

# --- Cryptography ------------------------------------------------------------

# PBKDF2 iteration count for hash_secret/derive_fernet_key. Lowering this
# weakens every secret hashed with it; raising it invalidates nothing, since
# the iteration count is stored alongside each record.
RIF_PBKDF2_ITERATIONS=600000

# HMAC signing key for Metasploit capability tokens. A random key is generated
# per process when unset, so tokens minted before a restart stop verifying
# after it. Set this to keep tokens valid across restarts.
RIF_MSF_BROKER_KEY=

# --- Supabase (optional) -----------------------------------------------------
#
# Only needed for the `rif-runtime[supabase]` extra. With SUPABASE_URL unset,
# the evidence-write helpers no-op and the runtime works local-only.

SUPABASE_URL=
# Service-role key — used by the runtime for run/evidence writes. Server-side
# only; it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
# Anon key — used to verify user JWTs presented to POST /v1/runs.
SUPABASE_ANON_KEY=
