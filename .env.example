# Copy to .env and fill in. Never commit .env.
# Loaded by compose.yaml / docker-compose.prod.yml.

# Required for control-plane routes (fail-closed if unset). Comma-separated.
RIF_CONTROL_PLANE_API_KEYS=replace-me-with-a-long-random-secret

# Optional
RIF_HOST_PORT=8000
RIF_CORS_ORIGINS=http://localhost:3000
RIF_IMAGE_TAG=v1.0.0

# Optional CORS / runtime knobs (see src/rif_runtime/config.py)
# RIF_ENVIRONMENT=RIF_Runtime
# RIF_DATA_DIR=data
# RIF_CONFIG_DIR=config
