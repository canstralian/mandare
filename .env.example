# Environment Configuration

# Runtime Configuration
RIF_LOG_LEVEL=INFO
RIF_DEBUG=false

# Server Configuration
RIF_SERVER_HOST=0.0.0.0
RIF_SERVER_PORT=8000
RIF_SERVER_WORKERS=4
RIF_API_VERSION=v1

# Storage Configuration
RIF_STORAGE_BACKEND=jsonl
RIF_STORAGE_DATA_DIR=./data
RIF_STORAGE_DECISIONS_FILE=decisions.jsonl
RIF_STORAGE_POSTURE_FILE=posture_history.jsonl

# Policy Configuration
RIF_POLICY_DEFAULT_FILE=config/policies.yaml
RIF_POLICY_AUTO_RELOAD=true
RIF_POLICY_RELOAD_INTERVAL_SECONDS=300

# Capability Configuration
RIF_CAPABILITIES_REGISTRY_FILE=config/capabilities.yaml
RIF_CAPABILITIES_TIMEOUT_SECONDS=30
RIF_CAPABILITIES_MAX_RETRIES=3

# Governance Configuration
RIF_GOVERNANCE_GRAPH_FILE=data/governance_graph.json
RIF_GOVERNANCE_REFLEXIVE_LOOP_ENABLED=true

# Security Configuration
RIF_SECURITY_SANDBOX_ENABLED=true
RIF_SECURITY_SANDBOX_MODE=strict  # strict, standard, permissive
RIF_SECURITY_CAPABILITY_DROP=ALL
RIF_SECURITY_NETWORK_ISOLATION=true
RIF_SECURITY_READONLY_FS=true
RIF_SECURITY_MEMORY_LIMIT_MB=512
RIF_SECURITY_CPU_LIMIT=1.0
RIF_SECURITY_PID_LIMIT=100
RIF_SECURITY_SIGNING_KEY_FILE=/run/secrets/rif_signing_key

# MCP Configuration
RIF_MCP_ENABLED=true
RIF_MCP_SERVERS_FILE=config/mcp_servers.yaml
RIF_MCP_TIMEOUT_SECONDS=30

# Authentication Configuration
RIF_AUTH_ENABLED=true
RIF_AUTH_JWT_SECRET_FILE=/run/secrets/jwt_secret
RIF_AUTH_JWT_ALGORITHM=HS256
RIF_AUTH_JWT_EXPIRATION_MINUTES=60

# Control-plane API key(s) actually enforced today (src/rif_runtime/auth.py):
# comma-separated allowlist gating POST /v1/policy/evaluate and other mutating
# routes. Fails closed (503) if unset. This placeholder is for local dev only
# — production deployments MUST replace it with a unique generated secret,
# never reuse this value.
RIF_CONTROL_PLANE_API_KEYS=local-dev-placeholder-change-me

# Audit Configuration
RIF_AUDIT_ENABLED=true
RIF_AUDIT_LOG_FILE=data/audit.jsonl
RIF_AUDIT_RETENTION_DAYS=90

# Telemetry Configuration
RIF_TELEMETRY_ENABLED=true
RIF_TELEMETRY_EXPORT_INTERVAL_SECONDS=60

# Database Configuration (if using SQL backend)
RIF_DB_BACKEND=postgres
RIF_DB_HOST=postgres
RIF_DB_PORT=5432
RIF_DB_NAME=rif_runtime
RIF_DB_USER=rif_user
RIF_DB_PASSWORD_FILE=/run/secrets/db_password
RIF_DB_SSL_MODE=require

# External Service Integration
RIF_ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
RIF_OPENAI_API_KEY_FILE=/run/secrets/openai_api_key

# Prometheus Metrics (optional)
RIF_METRICS_ENABLED=true
RIF_METRICS_PORT=9090

# Jaeger Tracing (optional)
RIF_TRACING_ENABLED=false
RIF_TRACING_JAEGER_ENDPOINT=http://jaeger:6831

# Feature Flags
RIF_FEATURE_REPLAY_ENABLED=true
RIF_FEATURE_EVIDENCE_EXPORT_ENABLED=true
RIF_FEATURE_REFLEXIVE_REVIEW_ENABLED=false  # Alpha feature

# Development / Testing
RIF_TEST_MODE=false
RIF_E2E_MODE=false
