# RIF Runtime Environment Configuration
# Copy this to .env and fill in actual values

# === Application Settings ===

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Evidence storage path (inside container)
EVIDENCE_PATH=/app/evidence

# Policy configuration path
POLICY_PATH=/etc/rif/policies

# Compliance rules path
COMPLIANCE_PATH=/etc/rif/compliance

# === API Settings ===

# API listen port (inside container)
API_PORT=8000

# API bind address
API_BIND=0.0.0.0

# === Database Settings (for v1.1+) ===

# PostgreSQL connection
DB_HOST=evidence-db
DB_PORT=5432
DB_NAME=rif_evidence
DB_USER=rif
# CHANGE THIS IN PRODUCTION
DB_PASSWORD=dev-password

# === Redis Settings (for v1.1+) ===

# Redis cache host
REDIS_HOST=cache
REDIS_PORT=6379

# === Security ===

# JWT secret (if authentication enabled in v1.1+)
# JWT_SECRET=your-super-secret-key-here

# API key (if API authentication enabled)
# API_KEY=your-api-key-here

# === Execution Environment ===

# Docker compose project name (prefix for container names)
COMPOSE_PROJECT_NAME=rif-runtime

# === Development Settings ===

# Enable debug mode (verbose logging)
DEBUG=false

# Enable profiling (pprof)
ENABLE_PROFILING=false

# === Observability ===

# Prometheus metrics port (if implemented)
# METRICS_PORT=9090

# Datadog agent host (if using Datadog)
# DD_AGENT_HOST=datadog-agent
# DD_AGENT_PORT=8125

# === Notes ===
# - Never commit secrets to version control
# - Use Docker secrets or external vault in production
# - Rotate DB_PASSWORD regularly
# - Use strong JWT_SECRET and API_KEY in production
