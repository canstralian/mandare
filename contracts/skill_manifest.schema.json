{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rif://contracts/skill-manifest/v0.1",
  "title": "RIF Skill Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "version", "description", "steps"],
  "properties": {
    "schema_version": {
      "const": "rif.skill-manifest/v0.1"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "capability_id"],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "capability"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "uniqueItems": true
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
